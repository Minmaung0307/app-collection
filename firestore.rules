rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Replace this value with the same UID used in VITE_ADMIN_UID.
  function owner() { return request.auth != null && request.auth.uid == 'REPLACE_WITH_OWNER_UID'; }
  function validPublic() {
   return request.resource.data.keys().hasOnly(['id','name','description','url','image','color','category','status','pricing','dateAdded','featured'])
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 100;
  }
  match /apps/{id} {
   allow read: if true;
   allow create, update: if owner() && validPublic();
   allow delete: if owner();
  }
  match /appPrivate/{id} {
   allow read, write: if owner();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
